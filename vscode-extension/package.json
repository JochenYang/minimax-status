{
  "name": "minimax-status-vscode",
  "displayName": "MiniMax Status",
  "description": "%extension.description%",
  "version": "1.5.2",
  "publisher": "JochenYang",
  "icon": "./public/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:minimaxStatusView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "minimaxStatus.setup",
        "title": "%command.setup.title%",
        "category": "MiniMax",
        "description": "%command.setup.description%"
      },
      {
        "command": "minimaxStatus.refresh",
        "title": "%command.refresh.title%",
        "category": "MiniMax",
        "description": "%command.refresh.description%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "minimaxStatusSidebar",
          "title": "MiniMax Status",
          "icon": "public/icon.png"
        }
      ]
    },
    "views": {
      "minimaxStatusSidebar": [
        {
          "id": "minimaxStatusView",
          "name": "%view.settings.name%"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "minimaxStatus.token": {
          "type": "string",
          "default": "",
          "description": "%config.token.description%",
          "order": 1
        },
        "minimaxStatus.refreshInterval": {
          "type": "number",
          "default": 30,
          "description": "%config.refreshInterval.description%",
          "order": 3
        },
        "minimaxStatus.showTooltip": {
          "type": "boolean",
          "default": true,
          "description": "%config.showTooltip.description%",
          "order": 4
        },
        "minimaxStatus.modelName": {
          "type": "string",
          "default": "",
          "description": "%config.modelName.description%",
          "order": 5
        },
        "minimaxStatus.overseasDisplay": {
          "type": "string",
          "enum": [
            "none",
            "overseas",
            "both"
          ],
          "default": "none",
          "description": "%config.overseasDisplay.description%",
          "order": 6
        },
        "minimaxStatus.overseasToken": {
          "type": "string",
          "default": "",
          "description": "%config.overseasToken.description%",
          "order": 7
        },
        "minimaxStatus.language": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en-US"
          ],
          "default": "zh-CN",
          "description": "%config.language.description%",
          "order": 8
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js",
    "package": "vsce package",
    "install-test": "npm install"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.21.0",
    "eslint": "^8.56.0",
    "mocha": "^11.7.5"
  },
  "dependencies": {
    "axios": "^1.6.2"
  },
  "keywords": [
    "minimax",
    "status",
    "claude"
  ],
  "author": "Jochen Yang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JochenYang/minimax-status"
  }
}
